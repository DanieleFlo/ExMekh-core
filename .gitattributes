# Preserve hosted-model continuation bytes exactly; these fixtures may contain
# model-generated trailing whitespace that is meaningful to tokenizer scoring.
gguf-tools/quality-testing/data/*/continuations/*.txt -diff

# Shell scripts are executed inside Linux/WSL even when the checkout is made
# by Git for Windows.  Preserve a valid shebang and Bash syntax.
*.sh text eol=lf
config/flash-cuda-standard.env text eol=lf

# Qwen metadata snapshots are validated by byte-level SHA-256 checksums.
gguf-tools/quality-testing/data/qwen38-metadata/*.json text eol=lf

# Native suite manifests and corpus identities are hashed byte for byte.
tests/fixtures/native-suite-v1/*.json text eol=lf
docs/performance/native-suite-t00-20261020/*.json text eol=lf
docs/performance/native-suite-t03-t04-20261020/*.json text eol=lf
docs/performance/native-suite-t05-t06-20261020/*.json text eol=lf
config/suite-bundles/*.json text eol=lf
schemas/ds4-suite-*.json text eol=lf

# Source and build files stay readable and executable across Windows/WSL.
# Model fixtures retain their existing byte-level rules above.
.gitattributes text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cu text eol=lf
*.cuh text eol=lf
*.inc text eol=lf
*.m text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
Makefile text eol=lf
*.mk text eol=lf

# Archived measurements and recovery patches retain their original bytes.
docs/experiments/qwen27-4bis-20261008/results/** -text whitespace=cr-at-eol
docs/experiments/qwen27-4bis-20261008/shared-integration.patch -text -whitespace

# Metal verification logs are hashed evidence, including literal shell/pytest
# trailing spaces. Keep those bytes; JSON identities use LF on every platform.
docs/performance/metal-apple-silicon-20261029/**/*.log -text -whitespace
docs/performance/metal-apple-silicon-20261029/**/*.json text eol=lf

docs/performance/metal-apple-silicon-20261031/**/*.log -text -whitespace
docs/performance/metal-apple-silicon-20261031/**/*.json text eol=lf

# Diagnostic prompts include tokenizer-significant final newlines.
docs/performance/metal-apple-silicon-20261031/t08-20261106/fixtures/*.prompt.txt -text -whitespace

# Preserve archived patch context, test reports and upstream diagnostic sources.
agent/vendor-patches/*.patch -text -whitespace
docs/performance/metal-apple-silicon-20261031/t06-t07/diagnostics/probe-sleef-tanh.metal -text -whitespace
