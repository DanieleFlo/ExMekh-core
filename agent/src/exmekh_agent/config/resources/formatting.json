{
  "indent_spaces": 2,
  "byte_unit_base": 1024,
  "byte_units": [
    "B",
    "KB",
    "MB",
    "GB"
  ],
  "compact_token_threshold": 100,
  "compact_token_base": 1000.0,
  "compact_token_template": "{count:.1f}k",
  "percentage_template": "{count:.1f}%",
  "byte_template": "{count} {unit}",
  "scaled_byte_template": "{count:.1f} {unit}",
  "exception_separator": " → ",
  "duration_hours_template": "{hours}h {minutes}m {seconds}s",
  "duration_minutes_template": "{minutes}m {seconds}s",
  "duration_seconds_template": "{seconds}s",
  "sidebar_date_template": "%d/%m %H:%M"
}
