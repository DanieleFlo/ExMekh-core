# Local LLM Server (LM Studio, Ollama, vLLM, llama.cpp)
BASE_URL=http://localhost:8080/v1
API_KEY=prova
DEFAULT_MODEL=Qwen3.8-27B-UD-Q4_K_S
REASONING_EFFORT=xhigh
AUTO_COMPACTION_THRESHOLD_PERCENT=80
INCLUDE_GENERATED_IMAGES_IN_CONTEXT=true

# Frontend Web Server Settings
EXMEKH_AGENT_HOST=127.0.0.1
EXMEKH_AGENT_PORT=8000
EXMEKH_AGENT_TITLE=ExMekh Agent

# DS4 hierarchical agent protocol
API_TYPE=responses
