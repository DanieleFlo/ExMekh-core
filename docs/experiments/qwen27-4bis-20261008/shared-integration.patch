+static void check_batch_catchup(ds4_session *s, const int *tokens,
+        unsigned position, unsigned rows, bool mrope, bool vision) {
+    ds4_engine *e = s->engine;
+    ds4_qwen_gpu_graph *g = &s->qwen_graph;
+    const uint64_t hidden_bytes = (uint64_t)DS4_N_EMBD * sizeof(float);
+    const uint64_t input_bytes = rows * hidden_bytes;
+    const uint64_t kv_bytes = (uint64_t)(position+rows)*DS4_N_HEAD_KV*DS4_N_HEAD_DIM*sizeof(float);
+    float *input = malloc(input_bytes), *carry = malloc(hidden_bytes);
+    float *key = NULL, *value = NULL, *expected_carry = NULL;
+    int32_t expected_delta = 0;
+    CHECK(input && carry && position+rows <= g->ctx_cap && rows <= g->prefill_cap);
+    for (uint64_t i = 0; i < input_bytes/sizeof(float); ++i)
+        input[i] = (float)((int)((i*131u+73u)%997u)-498)/1024.0f;
+    for (uint32_t i = 0; i < DS4_N_EMBD; ++i) carry[i] = input[i]*0.75f;
+    ds4_vision_span image = {.token_start = position + 2u, .embedding = {
+        .data = input, .token_count = 6u, .grid_height = 2u, .grid_width = 3u}};
+    CHECK(!vision || rows >= 8u);
+    for (unsigned batched = 0; batched < 2; ++batched) {
+        CHECK(setenv("DS4_CUDA_QWEN_MTP_BATCH_CATCHUP", batched ? "1" : "0", 1) == 0);
+        CHECK(qwen_graph_reset(g));
+        CHECK(ds4_gpu_tensor_write(g->cur, 0, input, input_bytes));
+        CHECK(ds4_gpu_tensor_write(g->mtp_pending_h, 0, carry, hidden_bytes));
+        g->mtp_cache_len = position;
+        g->vis_spans = vision ? &image : NULL;
+        g->vis_span_count = vision ? 1u : 0u;
+        if (mrope) {
+            g->rope_len = g->ctx_cap;
+            CHECK(qwen_graph_prepare_vision(g, 0, 1));
+            for (uint32_t i = 0; i < g->ctx_cap; ++i) {
+                g->host_pos3[i*3u] = i;
+                g->host_pos3[i*3u+1u] = i%11u;
+                g->host_pos3[i*3u+2u] = i%13u;
+            }
+        }
+        CHECK(qwen_graph_mtp_catchup_rows(g, &e->model, &e->weights,
+            &e->mtp_model, &e->qwen_mtp_weights, tokens, position, rows));
+        CHECK(!g->mtp_batch_catchup && g->mtp_cache_len == position+rows);
+        if (!batched) {
+            key = read_tensor(g->mtp_key_cache, kv_bytes);
+            value = read_tensor(g->mtp_value_cache, kv_bytes);
+            expected_carry = read_tensor(g->mtp_pending_h, hidden_bytes);
+            expected_delta = g->mrope_delta;
+        } else {
+            check_tensor(g->mtp_key_cache, key, kv_bytes);
+            check_tensor(g->mtp_value_cache, value, kv_bytes);
+            check_tensor(g->mtp_pending_h, expected_carry, hidden_bytes);
+            CHECK(g->mrope_delta == expected_delta);
+        }
+    }
+    g->vis_spans = NULL; g->vis_span_count = 0;
+    free(input);free(carry);free(key);free(value);free(expected_carry);
+    printf("{\"test\":\"mtp_batched_catchup\",\"pos\":%u,\"rows\":%u,\"mrope\":%u,\"vision\":%u,\"full_KV_and_carry_bit_exact\":true}\n",
+        position, rows, mrope, vision);
