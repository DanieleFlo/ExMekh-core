+        const uint64_t cb = ds4_gpu_tensor_bytes(g->conv_state[il]) * g->mtp_decode_rows_capacity;
+        const uint64_t rb = ds4_gpu_tensor_bytes(g->recurrent_state[il]) * g->mtp_decode_rows_capacity;
+        g->mtp_decode_conv_rows[il] = ds4_gpu_tensor_view(g->mtp_decode_rows, offset, cb); offset += cb;
