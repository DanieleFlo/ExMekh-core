+        g->mtp_decode_recurrent_rows[il] = NULL;
+    }
+    ds4_gpu_tensor_free(g->mtp_decode_rows); g->mtp_decode_rows = NULL;
+    g->mtp_decode_rows_tried = false; g->mtp_decode_rows_valid = 0;
+    g->mtp_decode_rows_capacity = 0;
