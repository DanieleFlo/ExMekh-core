+/* Warm decode independently of the measured prefill. Dense Qwen's compact
+ * same-session checkpoint restores recurrent state while retaining the
+ * unchanged prefix KV. Every warm-up token and checkpoint IO is untimed. */
+static int bench_qwen_decode_warmup(ds4_engine *engine, ds4_session *session,
+        const ds4_tokens *prefix, int tokens, bool speculative, int eos,
+        char *err, size_t errlen) {
+    if (!tokens) return 0;
+    FILE *fp=tmpfile();uint64_t written=0;
+    if (!fp || ds4_session_save_skill_state(session,fp,&written,NULL,err,errlen)) {
+        if (fp) fclose(fp);return 1;
+    }
+    int done=0,rc=0;
+    while (done<tokens) {
+        int first=ds4_session_argmax_excluding(session,eos),accepted[16],next=-1,n=1;
+        uint64_t rng=0;
+        if (first<0) {rc=1;break;}
+        if (speculative) n=ds4_session_eval_speculative_constrained_sample(session,first,0,0,1,0,&rng,
+            tokens-done,-1,accepted,16,&next,bench_qwen_non_eos,&eos,err,errlen);
+        else if (ds4_session_eval(session,first,err,errlen)) n=-1;
+        if (n<=0) {rc=1;break;}done+=n;
+    }
+    if (!rc && (!fseek(fp,0,SEEK_SET))) rc=ds4_session_load_skill_state(session,fp,prefix,NULL,err,errlen);
+    else rc=1;
+    if (fclose(fp)) rc=1;
+    if (!rc) fprintf(stderr,"ds4-bench: untimed decode warm-up completed=%d restored_frontier=%d\n",done,ds4_session_pos(session));
+    (void)engine;return rc;
 }
 
