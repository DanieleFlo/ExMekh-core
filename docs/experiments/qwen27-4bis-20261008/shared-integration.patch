+/* Shared CLI validation for the opt-in dense Qwen capacity backend. */
+static inline int ds4_env_set_qwen_kv_argument(const char *option, const char *value) {
+    if (!value || !value[0]) return 0;
+    if (!strcmp(option, "--qwen-kv-capacity-mode")) {
+        if (strcmp(value, "off") && strcmp(value, "grow") && strcmp(value, "hybrid-attention")) return 0;
+        return setenv("DS4_CUDA_QWEN_KV_CAPACITY_MODE", value, 1) == 0;
+    }
+    unsigned long n = 0;
+    for (const char *p = value; *p; ++p) {
+        if (*p < '0' || *p > '9' || n > 262144u) return 0;
+        n = n * 10u + (unsigned)(*p - '0');
+    }
+    if (n < 64u || n > 262144u) return 0;
+    return setenv("DS4_CUDA_QWEN_KV_RESIDENT", value, 1) == 0;
+}
+
+static inline int ds4_env_set_qwen_extended_draft(const char *value) {
+    if (!value || (strcmp(value,"auto")&&strcmp(value,"off")&&strcmp(value,"nextn")&&strcmp(value,"dspark"))) return 0;
+    return setenv("DS4_QWEN_EXTENDED_DRAFT",value,1)==0;
+}
+
+static inline int ds4_env_qwen_weight_streaming(void) {
+    return ds4_env_flag_enabled("DS4_CUDA_QWEN_WEIGHT_STREAMING", 0);
+}
+
+static inline int ds4_env_set_qwen_weight_argument(const char *option, const char *value) {
+    if (!value || !value[0]) return 0;
+    if (!strcmp(option, "--qwen-weight-streaming")) {
+        if (strcmp(value, "on") && strcmp(value, "off")) return 0;
+        return setenv("DS4_CUDA_QWEN_WEIGHT_STREAMING", value, 1) == 0;
+    }
+    unsigned long n = 0;
+    for (const char *p = value; *p; ++p) {
+        if (*p < '0' || *p > '9' || n > 32768u) return 0;
+        n = n * 10u + (unsigned)(*p - '0');
+    }
+    if (n > 32768u) return 0;
+    return setenv("DS4_CUDA_QWEN_WEIGHT_RESIDENT_MB", value, 1) == 0;
+}
+
+/* Mirrors the CUDA allocator's bounds after frontend validation. */
+static inline unsigned ds4_env_qwen_resident_cells(void) {
+    const char *value = getenv("DS4_CUDA_QWEN_KV_RESIDENT");
+    const unsigned long n = value && value[0] ? strtoul(value, NULL, 10) : 32768u;
+    return n < 64u ? 64u : n > 262144u ? 262144u : (unsigned)n;
