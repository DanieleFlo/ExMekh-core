  "responsibilities": {
    "resource_registry": "admission/reclaim projection, budgets, reservation scopes/events and accounting",
    "executor": "operation planning, lifecycle phases, journal, cancellation/recovery and publication",
    "engine_adapter": "model-specific checkpoint payloads and reclaim estimates behind public API",
    "bundle_loader": "verified directory, immutable file mappings and weight-group state",
    "offline_tools": "pinned specification, inventory, conversion, downloads and discovery"
  },
  "fixes": [
    "single admission policy for planner and root reservation",
    "cancellation at load/save/restore/recovery boundaries and before commit",
    "scopes pin leases across threads and nested TLS changes; scoped allocations inherit event",
    "one reverse group-release path shared by normal execution and recovery",
    "failed group drain/free cannot remain ready or reload prematurely",
    "reader preserves NOMEM instead of classifying all parse failures INVALID",
    "shared artifact identity check and one hash per unique discovery file",
    "early selector/revision/group validation and bounded incremental native index writer",
    "shared public-header build dependencies; Python imports and formatting"
  ],
  "broader_audit": [
    "CLI/server use opaque engine/session API",
    "ChatSession private calls on branch/revised are within the declaring class",
    "legacy engine/server globals and broad responsibilities remain explicit debt"
  ],
