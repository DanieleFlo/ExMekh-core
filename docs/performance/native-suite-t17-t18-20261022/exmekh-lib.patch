+"""Native DS4 service identities and tool presentation settings."""
+
+from dataclasses import dataclass
+from typing import Literal
+
+
+@dataclass(frozen=True, slots=True)
+class NativeSuiteSettings:
+    image_model: Literal["Qwen/Qwen-Image-2.1-Turbo"] = "Qwen/Qwen-Image-2.1-Turbo"
+    embedding_model: Literal["google/embeddinggemma-2"] = "google/embeddinggemma-2"
+    dimensions: int = 768
+    include_image_in_result: bool = True
+    preview_scale: float = 1.0
+    timeout_seconds: float = 600
+    image_description: str = (
+        "Generate or edit images using the configured native image model. Supply an "
+        "ordered list of reference paths for editing. Returns media IDs, local PNG "
+        "paths, seeds, recipe and dimensions. Pixel analysis requires a separate "
+        "explicit vision invocation."
+    )
+    embedding_description: str = (
+        "Embed ordered text, image, video or audio content in one shared vector "
+        "space using the native service. Returns vectors and their model identity."
+    )
+    unsupported_provider: str = "This provider does not expose the native suite."
+    invalid_response: str = "The native service returned an invalid response."
+    invalid_scale: str = "preview_scale must be greater than zero and at most one."
+    invalid_path: str = "Media paths must stay inside the workspace."
+
+
+NATIVE_SUITE = NativeSuiteSettings()
diff --git a/src/exmekh_lib/core/models/native_media_tools.py b/src/exmekh_lib/core/models/native_media_tools.py
new file mode 100644
index 0000000..0d5d101
--- /dev/null
+++ b/src/exmekh_lib/core/models/native_media_tools.py
@@ -0,0 +1,120 @@
+"""Explicit native media tools using the existing attachment delivery path."""
+
+from __future__ import annotations
+
+import base64
+import io
+import uuid
+from pathlib import Path
+from typing import Literal
+
+from PIL import Image
+
+from exmekh_lib.config.native_suite import NATIVE_SUITE
+from exmekh_lib.core.models.native_suite import (
+    EmbeddingItem,
+    TextContent,
+    suite_from_environment,
+)
+from exmekh_lib.core.models.tool import AttachedToolResult
+from exmekh_lib.core.models.user_message import ImagesUserMessage, UserMessage
+
+
+def workspace_media(work_root: Path, path: str) -> Path:
+    root = work_root.resolve()
+    resolved = (root / path).resolve()
+    if not resolved.is_relative_to(root):
+        raise ValueError(NATIVE_SUITE.invalid_path)
+    return resolved
+
+
+def generate_images(
+    work_root: Path,
+    prompt: str,
+    images: list[str] | None = None,
+    n: int = 1,
+    width: int = 1024,
+    height: int = 1024,
+    output_format: Literal["png"] = "png",
+    background: Literal["auto", "opaque", "transparent"] = "auto",
+    seed: int | None = None,
+    idempotency_key: str | None = None,
+    include_image_in_result: bool = NATIVE_SUITE.include_image_in_result,
+    preview_scale: float = NATIVE_SUITE.preview_scale,
+) -> dict[str, object]:
+    if not 0 < preview_scale <= 1:
+        raise ValueError(NATIVE_SUITE.invalid_scale)
+    suite = suite_from_environment()
+    references = [
+        suite.upload(workspace_media(work_root, path), kind="image")
+        for path in images or []
+    ]
+    response = suite.images(
+        prompt,
+        images=references,
+        n=n,
+        width=width,
+        height=height,
+        output_format=output_format,
+        background=background,
+        seed=seed,
+        idempotency_key=idempotency_key,
+    )
+    directory = workspace_media(
+        work_root, f".exmekh_lib/generated-media/{uuid.uuid4().hex}"
+    )
+    directory.mkdir(parents=True)
+    outputs: list[dict[str, object]] = []
+    previews: list[Image.Image] = []
+    for i, item in enumerate(response.data):
+        raw = base64.b64decode(item.b64_json, validate=True)
+        path = directory / f"{i}.png"
+        path.write_bytes(raw)
+        outputs.append({**item.ds4.model_dump(), "path": str(path)})
+        if include_image_in_result:
+            with Image.open(io.BytesIO(raw)) as decoded:
+                preview = decoded.copy()
+            if preview_scale != 1:
+                preview = preview.resize(
+                    (
+                        max(1, round(preview.width * preview_scale)),
+                        max(1, round(preview.height * preview_scale)),
+                    ),
+                    Image.Resampling.LANCZOS,
+                )
+            previews.append(preview)
+    result: dict[str, object] = {"images": outputs, "ds4": response.ds4}
+    if previews:
+        return AttachedToolResult(
+            result, UserMessage(ImagesUserMessage(images=previews))
+        )
+    return result
+
+
+def embed_content(
+    work_root: Path,
+    content: list[dict[str, str]],
+    dimensions: int = NATIVE_SUITE.dimensions,
+) -> dict[str, object]:
+    suite = suite_from_environment()
+    parts = []
+    for item in content:
+        allowed = {"type", "text"} if item.get("type") == "text" else {"type", "path"}
+        if item.get("type") == "video":
+            allowed.add("audio")
+        if set(item) - allowed or item.get("audio", "exclude") not in (
+            "include",
+            "exclude",
+        ):
+            raise ValueError(NATIVE_SUITE.invalid_response)
+        if item["type"] == "text":
+            parts.append(TextContent(text=item["text"]))
+        else:
+            kind = item["type"]
+            if kind not in ("image", "video", "audio"):
+                raise ValueError(NATIVE_SUITE.invalid_response)
+            media = suite.upload(workspace_media(work_root, item["path"]), kind=kind)
+            if kind == "video":
+                media.audio = item.get("audio", "exclude")  # type: ignore[assignment]
+            parts.append(media)
+    return suite.embeddings([EmbeddingItem(content=parts)], dimensions=dimensions)
diff --git a/src/exmekh_lib/core/models/native_suite.py b/src/exmekh_lib/core/models/native_suite.py
new file mode 100644
index 0000000..53de111
--- /dev/null
+++ b/src/exmekh_lib/core/models/native_suite.py
@@ -0,0 +1,216 @@
+"""Versioned DS4 media operations on the same OpenAI transport as chat."""
+
+from __future__ import annotations
+
+import io
+import mimetypes
+import os
+import uuid
+from collections.abc import Callable, Iterator, Sequence
+from contextlib import contextmanager
+from contextvars import ContextVar
+from pathlib import Path
+from typing import Any, Literal
+
+from openai import OpenAI
+from PIL import Image
+from pydantic import BaseModel, Field
+
+from exmekh_lib.config.native_suite import NATIVE_SUITE
+from exmekh_lib.config.provider import DEFAULT_PROVIDER_SETTINGS
+
+
+class TextContent(BaseModel):
+    model_config = {"extra": "forbid"}
+    type: Literal["text"] = "text"
+    text: str = Field(min_length=1)
+
+
+class MediaContent(BaseModel):
+    model_config = {"extra": "forbid"}
+    type: Literal["image", "video", "audio"]
+    file_id: str
+    audio: Literal["include", "exclude"] | None = None
+
+
+class EmbeddingItem(BaseModel):
+    model_config = {"extra": "forbid"}
+    content: list[TextContent | MediaContent] = Field(min_length=1)
+
+
+class GeneratedMedia(BaseModel):
+    file_id: str
+    seed: int
+    width: int
+    height: int
+    recipe: dict[str, Any]
+
+
+class GeneratedImage(BaseModel):
+    b64_json: str
+    ds4: GeneratedMedia
+
+
+class ImageBatch(BaseModel):
+    created: int
+    data: list[GeneratedImage]
+    ds4: dict[str, Any]
+
+
+class NativeCapabilities(BaseModel):
+    version: Literal[1]
+    revision: str
+    profile: Literal["bf16-native-v1"]
+    operations: list[Literal["image_generate", "image_edit", "embed"]]
+    input_modalities: list[Literal["text", "image", "video", "audio"]]
+    configured: bool
+    resident: bool
+    ready: bool
+
+
+class NativeModel(BaseModel):
+    id: Literal["Qwen/Qwen-Image-2.1-Turbo", "google/embeddinggemma-2"]
+    ds4: NativeCapabilities
+
+
+class NativeSuiteClient:
+    """No residency operations: each method waits for restored service state."""
+
+    def __init__(self, client: OpenAI) -> None:
+        self.transport = client
+
+    def models(self) -> list[NativeModel]:
+        data = self.transport.get("/models", cast_to=dict[str, Any])["data"]
+        return [
+            NativeModel.model_validate(item)
+            for item in data
+            if item["id"] in (NATIVE_SUITE.image_model, NATIVE_SUITE.embedding_model)
+        ]
+
+    def upload(
+        self, path: Path, *, kind: Literal["image", "video", "audio"]
+    ) -> MediaContent:
+        mime = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
+        mime = {"audio/x-wav": "audio/wav", "audio/x-flac": "audio/flac"}.get(
+            mime, mime
+        )
+        with path.open("rb") as source:
+            response = self.transport.files.create(
+                file=(path.name, source, mime),
+                purpose="ds4_media",  # type: ignore[arg-type]
+            )
+        return MediaContent(type=kind, file_id=response.id)
+
+    def upload_image(self, image: Image.Image) -> MediaContent:
+        stream = io.BytesIO()
+        image.save(stream, format="PNG")
+        response = self.transport.files.create(
+            file=("image.png", stream.getvalue(), "image/png"),
+            purpose="ds4_media",  # type: ignore[arg-type]
+        )
+        return MediaContent(type="image", file_id=response.id)
+
+    def content(self, file_id: str) -> bytes:
+        return self.transport.files.content(file_id).read()
+
+    def embeddings(
+        self,
+        items: Sequence[EmbeddingItem] | Sequence[str],
+        *,
+        dimensions: int = NATIVE_SUITE.dimensions,
+        task: Literal[
+            "raw", "search_query", "document", "code_query", "similarity"
+        ] = "raw",
+        title: str | None = None,
+    ) -> dict[str, Any]:
+        extension: dict[str, Any] = {"version": 1, "task": task, "overflow": "error"}
+        if title is not None:
+            extension["title"] = title
+        response = self.transport.post(
+            "/embeddings",
+            cast_to=dict[str, Any],
+            body={
+                "model": NATIVE_SUITE.embedding_model,
+                "dimensions": dimensions,
+                "encoding_format": "float",
+                "input": [
+                    item.model_dump(exclude_none=True)
+                    if isinstance(item, EmbeddingItem)
+                    else item
+                    for item in items
+                ],
+                "ds4": extension,
+            },
+        )
+        if len(response["data"]) != len(items) or any(
+            row["index"] != i or len(row["embedding"]) != dimensions
+            for i, row in enumerate(response["data"])
+        ):
+            raise ValueError(NATIVE_SUITE.invalid_response)
+        return response
+
+    def images(
+        self,
+        prompt: str,
+        *,
+        images: Sequence[MediaContent] = (),
+        n: int = 1,
+        width: int = 1024,
+        height: int = 1024,
+        output_format: Literal["png"] = "png",
+        background: Literal["auto", "opaque", "transparent"] = "auto",
+        seed: int | None = None,
+        idempotency_key: str | None = None,
+    ) -> ImageBatch:
+        extension: dict[str, Any] = {"version": 1, "sampling": "checkpoint"}
+        if seed is not None:
+            extension["seed"] = seed
+        body: dict[str, Any] = {
+            "model": NATIVE_SUITE.image_model,
+            "prompt": prompt,
+            "n": n,
+            "size": f"{width}x{height}",
+            "output_format": output_format,
+            "background": background,
+            "ds4": extension,
+        }
+        if images:
+            body["images"] = [item.file_id for item in images]
+        response = self.transport.post(
+            "/images/edits" if images else "/images/generations",
+            cast_to=dict[str, Any],
+            body=body,
+            options={
+                "headers": {"Idempotency-Key": idempotency_key or str(uuid.uuid4())}
+            },
+        )
+        return ImageBatch.model_validate(response)
+
+
+_suite_factory: ContextVar[Callable[[], NativeSuiteClient] | None] = ContextVar(
+    "native_suite_factory", default=None
+)
+
+
+@contextmanager
+def native_suite_context(factory: Callable[[], NativeSuiteClient]) -> Iterator[None]:
+    token = _suite_factory.set(factory)
+    try:
+        yield
+    finally:
+        _suite_factory.reset(token)
+
+
+def suite_from_environment() -> NativeSuiteClient:
+    """Tools and web ranking share the existing provider URL/key settings."""
+    factory = _suite_factory.get()
+    if factory is not None:
+        return factory()
+    settings = DEFAULT_PROVIDER_SETTINGS
+    return NativeSuiteClient(
+        OpenAI(
+            base_url=os.environ[settings.base_url_env_var],
+            api_key=os.getenv(settings.api_key_env_var) or settings.fallback_api_key,
+            timeout=NATIVE_SUITE.timeout_seconds,
+        )
+    )
diff --git a/tests/core/models/test_native_suite.py b/tests/core/models/test_native_suite.py
new file mode 100644
index 0000000..7e71098
--- /dev/null
+++ b/tests/core/models/test_native_suite.py
@@ -0,0 +1,179 @@
+"""Native media transport, explicit tools and attachment behavior."""
+
+import base64
+import inspect
+import io
+import json
+from pathlib import Path
+
+import httpx2
+import pytest
+from openai import OpenAI
+from PIL import Image
+
+from exmekh_lib.config.capabilities import CAPABILITY_FORMAT
+from exmekh_lib.core.agents.tools.deep_tools import DeepTools
+from exmekh_lib.core.models.native_media_tools import generate_images, workspace_media
+from exmekh_lib.core.models.native_suite import (
+    EmbeddingItem,
+    MediaContent,
+    NativeSuiteClient,
+    TextContent,
+    native_suite_context,
+    suite_from_environment,
+)
+from exmekh_lib.core.models.tool import AttachedToolResult
+
+
+def transport(handler):
+    return NativeSuiteClient(
+        OpenAI(
+            base_url="http://native/v1",
+            api_key="test",
+            http_client=httpx2.Client(transport=httpx2.MockTransport(handler)),
+        )
+    )
+
+
+def test_order_task_and_no_residency_commands():
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        body = json.loads(request.content)
+        assert body["input"][0]["content"] == [
+            {"type": "text", "text": "first"},
+            {"type": "video", "file_id": "file-video", "audio": "include"},
+            {"type": "text", "text": "last"},
+        ]
+        assert body["ds4"] == {
+            "version": 1,
+            "task": "document",
+            "overflow": "error",
+            "title": "Title",
+        }
+        return httpx2.Response(
+            200, json={"data": [{"index": 0, "embedding": [1.0] * 128}]}
+        )
+
+    suite = transport(handler)
+    result = suite.embeddings(
+        [
+            EmbeddingItem(
+                content=[
+                    TextContent(text="first"),
+                    MediaContent(type="video", file_id="file-video", audio="include"),
+                    TextContent(text="last"),
+                ]
+            )
+        ],
+        dimensions=128,
+        task="document",
+        title="Title",
+    )
+    assert len(result["data"]) == 1
+    assert [r.url.path for r in requests] == ["/v1/embeddings"]
+    with native_suite_context(lambda: suite):
+        assert suite_from_environment() is suite
+
+
+def test_registered_tools_have_their_own_entrypoints(tmp_path):
+    tools = DeepTools(
+        [
+            CAPABILITY_FORMAT.bundled_root / "tools" / name
+            for name in ("generate-image", "embed-content")
+        ],
+        work_root=tmp_path,
+    )
+    loaded = tools.load()
+    assert len(loaded) == 2
+    tools.unload()
+    for method in (
+        NativeSuiteClient.images,
+        NativeSuiteClient.embeddings,
+        generate_images,
+    ):
+        assert "model" not in inspect.signature(method).parameters
+    assert "size" not in inspect.signature(NativeSuiteClient.images).parameters
+    assert {"width", "height"} <= inspect.signature(
+        NativeSuiteClient.images
+    ).parameters.keys()
+
+
+def test_multiple_images_preview_configuration_and_workspace_paths(tmp_path):
+    stream = io.BytesIO()
+    Image.new("RGBA", (32, 32), "red").save(stream, "PNG")
+    encoded = base64.b64encode(stream.getvalue()).decode()
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        assert request.headers["Idempotency-Key"]
+        body = json.loads(request.content)
+        assert body["n"] == 2
+        return httpx2.Response(
+            200,
+            json={
+                "created": 1,
+                "ds4": {"revision": "test", "profile": "bf16"},
+                "data": [
+                    {
+                        "b64_json": encoded,
+                        "ds4": {
+                            "file_id": f"file-{i}",
+                            "seed": 17 + i,
+                            "width": 32,
+                            "height": 32,
+                            "recipe": {"steps": 8},
+                        },
+                    }
+                    for i in range(2)
+                ],
+            },
+        )
+
+    suite = transport(handler)
+    with native_suite_context(lambda: suite):
+        result = generate_images(
+            tmp_path, "red", n=2, width=32, height=32, preview_scale=0.5
+        )
+        assert isinstance(result, AttachedToolResult)
+        previews = list(result.attachments.iter_content_parts())
+        assert [item.size for item in previews] == [(16, 16), (16, 16)]
+        for row in result["images"]:
+            assert Path(row["path"]).read_bytes() == stream.getvalue()
+        no_pixels = generate_images(tmp_path, "red", n=2, include_image_in_result=False)
+        assert not isinstance(no_pixels, AttachedToolResult)
+    with pytest.raises(ValueError):
+        workspace_media(tmp_path, "../escape.png")
+    assert all(r.url.path == "/v1/images/generations" for r in requests)
+
+
+def test_upload_uses_native_file_purpose_and_returns_reference(tmp_path):
+    path = tmp_path / "clip.wav"
+    path.write_bytes(b"RIFF-fixture")
+
+    def handler(request):
+        assert request.url.path == "/v1/files"
+        assert b"ds4_media" in request.content
+        assert b"RIFF-fixture" in request.content
+        return httpx2.Response(
+            200,
+            json={
+                "id": "file-audio",
+                "object": "file",
+                "bytes": 12,
+                "created_at": 1,
+                "filename": "clip.wav",
+                "purpose": "ds4_media",
+            },
+        )
+
+    media = transport(handler).upload(path, kind="audio")
+    assert media.type == "audio" and media.file_id == "file-audio"
+
+
+def test_invalid_embedding_shape_is_rejected():
+    suite = transport(lambda r: httpx2.Response(200, json={"data": []}))
+    with pytest.raises(ValueError):
+        suite.embeddings(["text"])
