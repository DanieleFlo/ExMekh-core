quired":["document"]},"strict":true,"description":"Requires open skill 'file-processing'."},{"type":"function","name":"read-file","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_index":{"type":"integer"},"end_index":{"type":"integer"}},"additionalProperties":false,"required":["path","start_index","end_index"]},"strict":true,"description":"Requires open skill 'file-processing'."},{"type":"function","name":"exit_agent","parameters":{"type":"object","properties":{"text":{"type":"string"},"items":{"type":"array","items":{"type":"string"}}},"additionalProperties":false,"required":["text","items"]},"strict":true,"description":"Close the current skill; return text and selected saved outputs to its caller. Available in every skill."}],"temperature":0}

