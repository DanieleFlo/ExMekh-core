inline float2 nm_df_add(float2 x, float2 y) {
#pragma clang fp contract(off)
    float s = x.x + y.x;
    return float2(s, ((x.x - s) + y.x) + x.y + y.y);
}
inline float2 nm_df_add2(float2 x, float2 y) {
#pragma clang fp contract(off)
    float s = x.x + y.x, v = s - x.x;
    return float2(s, ((x.x - (s - v)) + (y.x - v)) + (x.y + y.y));
}
inline float2 nm_df_add_scalar(float2 x, float y) {
#pragma clang fp contract(off)
    float s = x.x + y, v = s - x.x;
    return float2(s, ((x.x - (s - v)) + (y - v)) + x.y);
}
inline float2 nm_df_mul_scalar(float2 x, float y) {
#pragma clang fp contract(off)
    float s = x.x * y;
    return float2(s, fma(x.y, y, fma(x.x, y, -s)));
}
inline float2 nm_df_mul(float2 x, float2 y) {
#pragma clang fp contract(off)
    float s = x.x * y.x;
    return float2(s, fma(x.x, y.y, fma(x.y, y.x, fma(x.x, y.x, -s))));
}
inline float2 nm_df_square(float2 x) {
#pragma clang fp contract(off)
    float s = x.x * x.x;
    return float2(s, fma(x.x + x.x, x.y, fma(x.x, x.x, -s)));
}
inline float2 nm_df_recip(float2 d) {
#pragma clang fp contract(off)
    float s = 1.0f / d.x;
    return float2(s, s * fma(-d.y, s, fma(-d.x, s, 1.0f)));
}
inline float2 nm_df_div(float2 n, float2 d) {
#pragma clang fp contract(off)
    float t = 1.0f / d.x, s = n.x * t, u = fma(t, n.x, -s);
    float v = fma(-d.y, t, fma(-d.x, t, 1.0f));
    return float2(s, fma(s, v, fma(n.y, t, u)));
}
inline float2 nm_df_exp(float x) {
#pragma clang fp contract(off)
    int q = int(rint(x * 1.44269504088896340736f));
    float2 s = nm_df_add_scalar(float2(x, 0), float(q) * (-0.693145751953125f));
    s = nm_df_add_scalar(s, float(q) * (-1.428606765330187045e-6f));
    float u = 0.1980960224e-3f;
    u = fma(u, s.x, 0.1394256484e-2f);
    u = fma(u, s.x, 0.8333456703e-2f);
    u = fma(u, s.x, 0.4166637361e-1f);
    float2 t = nm_df_add_scalar(nm_df_mul_scalar(s, u), 0.16666665941423424479f);
    t = nm_df_add_scalar(nm_df_mul(s, t), 0.5f);
    t = nm_df_add2(s, nm_df_mul(nm_df_square(s), t));
    float hi = 1.0f + t.x;
    t = float2(hi, ((1.0f - hi) + t.x) + t.y);
    return ldexp(ldexp(t, int2(q >> 1)), int2(q - (q >> 1)));
}
inline float nm_sleef_tanh(float x) {
#pragma clang fp contract(off)
    if (isnan(x))
        return x;
    if (abs(x) > 8.664339742f)
        return copysign(1.0f, x);
    float2 d = nm_df_exp(abs(x)), e = nm_df_recip(d);
    d = nm_df_div(nm_df_add(d, -e), nm_df_add(d, e));
    return copysign(d.x + d.y, x);
}
inline float nm_sleef_exp(float d) {
#pragma clang fp contract(off)
    if (isnan(d))
        return d;
    if (d < -104)
        return 0;
    if (d > 100)
        return INFINITY;
    int q = int(rint(d * 1.44269504088896340736f));
    float s = fma(float(q), -0.693145751953125f, d);
    s = fma(float(q), -1.428606765330187045e-6f, s);
    float u = 0.000198527617612853646278381f;
    u = fma(u, s, 0.00139304355252534151077271f);
    u = fma(u, s, 0.00833336077630519866943359f);
    u = fma(u, s, 0.0416664853692054748535156f);
    u = fma(u, s, 0.166666671633720397949219f);
    u = fma(u, s, 0.5f);
    u = 1.0f + fma(s * s, u, s);
    return ldexp(ldexp(u, q >> 1), q - (q >> 1));
}

inline float nm_bf16_gelu_tanh(float x) {
#pragma clang fp contract(off)
    float cube = x * x * x;
    return 0.5f * x * (1.0f + nm_sleef_tanh(0.7978845608028654f * (x + 0.044715f * cube)));
}
// x/2 is exact before BF16 rounding in this interval; integer RNE avoids
// Metal's permitted flushing of FP32 subnormal operands and results.
inline bool nm_bf16_tiny_activation(device uchar *y, device const uchar *x, ulong i) {
#pragma clang fp contract(off)
    ushort bits = ((device const ushort *)x)[i];
    uint magnitude = bits & 0x7fff;
    if (magnitude >= 0x100)
        return false;
    uint halved = magnitude >> 1;
    halved += (magnitude & 1) & (halved & 1);
    ((device ushort *)y)[i] = ushort((bits & 0x8000) | halved);
    return true;
}

// Fixed FP32 reduction order, independently written from the pinned ATen
// BF16 no-BFDOT operation order. No CPU execution in the native forward.
kernel void nm_bf16_linear(constant ds4_nm_args &a [[buffer(0)]], device uchar *y [[buffer(1)]],
                           device const uchar *x [[buffer(2)]], device const uchar *w [[buffer(3)]],
                           device const uchar *bias [[buffer(4)]],
                           uint gid [[thread_position_in_grid]]) {
#pragma clang fp contract(off)
    uint rows = a.u[0], inner = a.u[1], columns = a.u[2];
    ulong index = gid;
    if (index >= ulong(rows) * columns)
        return;
    ulong row = index / columns, col = index % columns;
    float sums[32] = {};
    uint aligned = inner / 32 * 32;
    for (uint k = 0; k < aligned; k += 32) {
#pragma unroll
        for (uint lane = 0; lane < 32; lane++)
            sums[lane] = fma(rd(x, row * inner + k + lane, 30), rd(w, col * inner + k + lane, 30),
                             sums[lane]);
    }
    for (uint span = 16; span >= 4; span /= 2)
        for (uint lane = 0; lane < span; lane++)
            sums[lane] += sums[lane + span];
    float result = (sums[0] + sums[1]) + (sums[2] + sums[3]);
    float tail[4] = {};
    uint aligned8 = inner / 8 * 8;
    for (uint k = aligned; k < aligned8; k += 8)
        for (uint lane = 0; lane < 4; lane++)
            tail[lane] =
                fma(rd(x, row * inner + k + lane + 4, 30), rd(w, col * inner + k + lane + 4, 30),
                    fma(rd(x, row * inner + k + lane, 30), rd(w, col * inner + k + lane, 30),
                        tail[lane]));
    result += (tail[0] + tail[1]) + (tail[2] + tail[3]);
    for (uint k = aligned8; k < inner; k++)
        result = fma(rd(x, row * inner + k, 30), rd(w, col * inner + k, 30), result);
    if (a.u[3])
        result += rd(bias, col, a.t[4]);
    wr(y, index, a.t[1], result);
}

inline float4 nm_linear_reduce32(float4 partial) {
#pragma clang fp contract(off)
    partial += simd_shuffle_down(partial, 16);
    partial += simd_shuffle_down(partial, 8);
    partial += simd_shuffle_down(partial, 4);
    return (simd_shuffle(partial, 0) + simd_shuffle(partial, 1)) +
           (simd_shuffle(partial, 2) + simd_shuffle(partial, 3));
}

// One SIMD group computes four activation rows for two adjacent output columns.
// Each lane owns one of the scalar kernel's 32 independent FP32 chains.
kernel void nm_bf16_linear_tile(constant ds4_nm_args &a [[buffer(0)]],
                                device uchar *y [[buffer(1)]],
                                device const uchar *x [[buffer(2)]],
                                device const uchar *w [[buffer(3)]],
                                device const uchar *bias [[buffer(4)]],
                                uint gid [[thread_position_in_grid]],
                                ushort lane [[thread_index_in_simdgroup]]) {
#pragma clang fp contract(off)
    uint rows = a.u[0], inner = a.u[1], columns = a.u[2];
    uint tile = gid / 32, pairs = columns / 2;
    uint row = (tile / pairs) * 4, col = (tile % pairs) * 2;
    ulong x0 = ulong(row) * inner;
    ulong x1 = ulong(min(row + 1, rows - 1)) * inner;
    ulong x2 = ulong(min(row + 2, rows - 1)) * inner;
    ulong x3 = ulong(min(row + 3, rows - 1)) * inner;
    ulong w0 = ulong(col) * inner, w1 = w0 + inner;
    float4 first = 0, second = 0;
    for (uint k = 0; k < inner; k += 32) {
        ulong j = ulong(k) + lane;
        float4 input(rd(x, x0 + j, 30), rd(x, x1 + j, 30),
                     rd(x, x2 + j, 30), rd(x, x3 + j, 30));
        first = fma(input, float4(rd(w, w0 + j, 30)), first);
        second = fma(input, float4(rd(w, w1 + j, 30)), second);
    }
    // Aligned K has an empty tail. Preserve the scalar kernel's addition.
    first = nm_linear_reduce32(first) + 0.0f;
    second = nm_linear_reduce32(second) + 0.0f;
    if (lane == 0) {
        if (a.u[3]) {
            first += rd(bias, col, a.t[4]);
            second += rd(bias, col + 1, a.t[4]);
        }
        for (uint i = 0; i < 4 && row + i < rows; ++i) {
            ulong index = ulong(row + i) * columns + col;
            wr(y, index, a.t[1], first[i]);
            wr(y, index + 1, a.t[1], second[i]);
        }
    }
}

// Fixed BF16 RMS row reduction, independently expressed with SIMD shuffles.
// The cascade and final scalar order follow the pinned CPU oracle's sum.
kernel void nm_bf16_rms(constant ds4_nm_args &a [[buffer(0)]], device uchar *y [[buffer(1)]],
                        device const uchar *x [[buffer(2)]],
                        device const uchar *weight [[buffer(3)]],
                        device const uchar *bias [[buffer(4)]],
                        uint row [[threadgroup_position_in_grid]],
                        uint lane [[thread_index_in_threadgroup]]) {
#pragma clang fp contract(off)
    if (lane >= 32)
        return;
    uint width = a.u[0];
    ulong base = ulong(row) * width;
    float levels[4] = {};
    uint count = width / 32;
    uint power = max(4u, (count > 1 ? 32u - clz(count - 1) : 0u) / 4u);
    uint step = 1u << power, mask = step - 1;
    for (uint i = 0; i < count; i++) {
        float value = rd(x, base + i * 32 + lane, a.t[2]);
        levels[0] += value * value;
        if ((i + 1) % step == 0) {
            for (uint level = 1; level < 4; level++) {
                levels[level] += levels[level - 1];
                levels[level - 1] = 0;
                if ((i + 1) & (mask << (level * power)))
                    break;
            }
        }
    }
    float value = ((levels[0] + levels[1]) + levels[2]) + levels[3];
    uint pairs = (width / 4 - count * 8) / 2;
    if (lane < 8) {
        for (uint i = 0; i < pairs; i++) {
            uint j = (count * 8 + i * 2 + lane / 4) * 4 + lane % 4;
            float z = rd(x, base + j, a.t[2]);
            value += z * z;
        }
    }
    float grouped = simd_shuffle(value, lane % 8);
    grouped += simd_shuffle(value, lane % 8 + 8);
    grouped += simd_shuffle(value, lane % 8 + 16);
    grouped += simd_shuffle(value, lane % 8 + 24);
    float sum = 0;
    for (uint j = (count * 8 + pairs * 2) * 4; j < width; j++) {
        float z = rd(x, base + j, a.t[2]);
        sum += z * z;
    }
    for (uint j = 0; j < 8; j++)
        sum += simd_shuffle(grouped, j);
    float factor = 1.0f / precise::sqrt(sum / width + a.f[0]);
    simdgroup_barrier(mem_flags::mem_device);
    for (uint j = lane; j < width; j += 32) {
        float z = rd(x, base + j, a.t[2]) * factor;
        if (a.u[3])
            z = rnd(z, a.t[2]);
        if (a.u[2])
            z *= rd(weight, j, a.t[3]) + (a.u[2] == 2 ? 1.0f : 0.0f);
        if (a.u[4])
            z += rd(bias, j, a.t[4]);
        wr(y, base + j, a.t[1], z);
    }
}

kernel void nm_ordered_softmax(constant ds4_nm_args &a [[buffer(0)]], device uchar *y [[buffer(1)]],
                               device const uchar *x [[buffer(2)]],
                               device const uint *bounds [[buffer(3)]],
                               uint row [[threadgroup_position_in_grid]],
                               uint tid [[thread_index_in_threadgroup]]) {
#pragma clang fp contract(off)
    threadgroup float stats[2];
    uint width = a.u[0], lo = bounds[2 * row], hi = bounds[2 * row + 1];
    if (!tid) {
        float maximum = -INFINITY, sum[4] = {};
        for (uint j = lo; j < hi; j++)
            maximum = max(maximum, rnd(rd(x, ulong(row) * width + j, a.t[2]) * a.f[0], a.t[2]));
        for (uint j = lo; j < hi; j++)
            sum[j % 4] +=
                nm_sleef_exp(rnd(rd(x, ulong(row) * width + j, a.t[2]) * a.f[0], a.t[2]) - maximum);
        stats[0] = maximum;
        stats[1] = 1.0f / ((sum[0] + sum[2]) + (sum[1] + sum[3]));
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint j = tid; j < width; j += 256)
        wr(y, ulong(row) * width + j, a.t[1],
           j < lo || j >= hi
               ? 0
               : nm_sleef_exp(rnd(rd(x, ulong(row) * width + j, a.t[2]) * a.f[0], a.t[2]) -
                              stats[0]) *
                     stats[1]);
}

// CPU BF16 boundaries and ATen FP32 softmax reduction, bounded workspace.
// Ordered BF16 dot: full NEON blocks, paired vector tail, then scalar tail.
inline float nm_bf16_attention_dot(device const uchar *q, device const uchar *k, ulong qi, ulong ki,
                                   uint dim, uint lane, bool four_streams) {
#pragma clang fp contract(off)
    float dot = 0;
    if (four_streams) {
        float partial = 0;
        if (lane < 4)
            for (uint d = lane; d < dim; d += 4)
                partial = fma(rd(q, qi + d, 30), rd(k, ki + d, 30), partial);
        dot = ((simd_shuffle(partial, 0) + simd_shuffle(partial, 1)) + simd_shuffle(partial, 2)) +
              simd_shuffle(partial, 3);
    } else {
        uint aligned = dim / 32 * 32, aligned8 = dim / 8 * 8;
        for (uint d = lane; d < aligned; d += 32)
            dot = fma(rd(q, qi + d, 30), rd(k, ki + d, 30), dot);
        dot += simd_shuffle_down(dot, 16);
        dot += simd_shuffle_down(dot, 8);
        dot += simd_shuffle_down(dot, 4);
        dot = (simd_shuffle(dot, 0) + simd_shuffle(dot, 1)) +
              (simd_shuffle(dot, 2) + simd_shuffle(dot, 3));
        float tail = 0;
        if (lane < 4)
            for (uint d = aligned; d < aligned8; d += 8)
                tail = fma(rd(q, qi + d + lane + 4, 30), rd(k, ki + d + lane + 4, 30),
                           fma(rd(q, qi + d + lane, 30), rd(k, ki + d + lane, 30), tail));
        dot += (simd_shuffle(tail, 0) + simd_shuffle(tail, 1)) +
               (simd_shuffle(tail, 2) + simd_shuffle(tail, 3));
        if (!lane)
            for (uint d = aligned8; d < dim; d++)
                dot = fma(rd(q, qi + d, 30), rd(k, ki + d, 30), dot);
        dot = simd_shuffle(dot, 0);
    }
    return dot;
}

kernel void nm_bf16_attention(constant ds4_nm_args &a [[buffer(0)]], device uchar *y [[buffer(1)]],
                              device const uchar *q [[buffer(2)]],
                              device const uchar *k [[buffer(3)]],
                              device const uchar *v [[buffer(4)]],
                              device const uint *bounds [[buffer(6)]],
                              uint g [[threadgroup_position_in_grid]],
                              uint tid [[thread_index_in_threadgroup]]) {
#pragma clang fp contract(off)
    threadgroup float scores[8], prob[8], stats[2];
    uint dim = a.u[5], heads = a.u[3], kvh = a.u[4], keys = a.u[2], queries = a.u[1];
    uint h = g % heads, row = g / heads, bt = row / queries;
    uint lo = bounds[2 * row], hi = bounds[2 * row + 1], warp = tid / 32, lane = tid % 32;
    ulong qi = ulong(g) * dim;
    float maximum = -INFINITY, denom[4] = {}, acc0[4] = {}, acc1[4] = {};
    for (uint pass = 0; pass < 3; pass++) {
        for (uint base = lo; base < hi; base += 8) {
            uint key = base + warp;
            float z = -INFINITY;
            if (key < hi) {
                ulong ki = ((ulong(bt) * keys + key) * kvh + h / (heads / kvh)) * dim;
                float dot = nm_bf16_attention_dot(q, k, qi, ki, dim, lane, a.u[0] > 1 && heads > 1);
                z = rnd(rnd(dot, a.t[2]) * a.f[0], a.t[2]);
                if (a.f[1] > 0)
                    z = a.f[1] * stable_tanh(z / a.f[1]);
            }
            if (!lane)
                scores[warp] = z;
            threadgroup_barrier(mem_flags::mem_threadgroup);
            if (pass == 0) {
                if (!tid) {
                    for (uint j = 0; j < 8 && base + j < hi; j++)
                        maximum = max(maximum, scores[j]);
                    stats[0] = maximum;
                }
            } else if (pass == 1) {
                if (!tid) {
                    for (uint j = 0; j < 8 && base + j < hi; j++)
                        denom[(base + j) % 4] += nm_sleef_exp(scores[j] - stats[0]);
                }
            } else {
                if (tid < 8)
                    prob[tid] = base + tid < hi
                                    ? rnd(nm_sleef_exp(scores[tid] - stats[0]) * stats[1], a.t[2])
                                    : 0;
                threadgroup_barrier(mem_flags::mem_threadgroup);
                for (uint j = 0; j < 8 && base + j < hi; j++) {
                    ulong vi = ((ulong(bt) * keys + base + j) * kvh + h / (heads / kvh)) * dim;
                    uint s = base + j < keys / 4 * 4 ? (base + j) % 4 : 0;
                    if (tid < dim)
                        acc0[s] += prob[j] * rd(v, vi + tid, a.t[4]);
                    if (tid + 256 < dim)
                        acc1[s] += prob[j] * rd(v, vi + tid + 256, a.t[4]);
                }
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
        }
        if (pass == 1 && !tid)
            stats[1] = 1.0f / ((denom[0] + denom[2]) + (denom[1] + denom[3]));
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if (tid < dim)
        wr(y, qi + tid, a.t[1], ((acc0[0] + acc0[1]) + acc0[2]) + acc0[3]);
    if (tid + 256 < dim)
        wr(y, qi + tid + 256, a.t[1], ((acc1[0] + acc1[1]) + acc1[2]) + acc1[3]);
}

// Independently expressed FP32 Welford order from pinned ATen CPU BF16.
// Four lanes represent the two halves of NEON's eight-BF16 vector.
struct nm_bf16_moment {
    uint count;
    float mean;
    float m2;
};
inline nm_bf16_moment nm_bf16_moment_vector_join(nm_bf16_moment left, nm_bf16_moment right) {
#pragma clang fp contract(off)
    uint count = left.count + right.count;
    float c = count ? float(right.count) / float(count) : 0;
    float delta = right.mean - left.mean;
    float m2 = fma(delta * float(left.count), c * delta, left.m2 + right.m2);
    return {count, left.mean + c * delta, m2};
}
inline nm_bf16_moment nm_bf16_moment_scalar_join(nm_bf16_moment left, nm_bf16_moment right) {
#pragma clang fp contract(off)
    uint count = left.count + right.count;
    float c = count ? float(right.count) / float(count) : 0;
    float delta = right.mean - left.mean;
    return {count, fma(c, delta, left.mean),
            left.m2 + fma(delta * delta * c, float(left.count), right.m2)};
}
kernel void nm_bf16_layernorm(constant ds4_nm_args &a [[buffer(0)]], device uchar *y [[buffer(1)]],
                              device const uchar *x [[buffer(2)]],
                              device const uchar *weight [[buffer(3)]],
                              device const uchar *bias [[buffer(4)]],
                              uint row [[threadgroup_position_in_grid]],
                              uint lane [[thread_index_in_threadgroup]]) {
#pragma clang fp contract(off)
    if (lane >= 4)
        return;
    uint width = a.u[0], vectors = width / 8, chunks = (vectors + 15) / 16;
    uint depth = chunks > 1 ? 32 - clz(chunks - 1) : 0;
    ulong base = ulong(row) * width;
    nm_bf16_moment stack[DS4_NM_BF16_LAYERNORM_LEVELS];
    for (uint i = 0; i < DS4_NM_BF16_LAYERNORM_LEVELS; i++)
        stack[i] = {0, 0, 0};
    for (uint block = 0; block < chunks; block++) {
        uint count = min(16u, vectors - block * 16);
        nm_bf16_moment part0 = {count, 0, 0}, part1 = {count, 0, 0};
        for (uint j = 0; j < count; j++) {
            float c = 1.0f / float(j + 1);
            ulong at = base + ulong(block * 16 + j) * 8 + lane;
            float x0 = rd(x, at, a.t[2]), x1 = rd(x, at + 4, a.t[2]);
            float d0 = x0 - part0.mean, d1 = x1 - part1.mean;
            part0.mean = fma(d0, c, part0.mean);
            part1.mean = fma(d1, c, part1.mean);
            part0.m2 = fma(d0, x0 - part0.mean, part0.m2);
            part1.m2 = fma(d1, x1 - part1.mean, part1.m2);
        }
        stack[0] = nm_bf16_moment_vector_join(stack[0], part0);
        stack[0] = nm_bf16_moment_vector_join(stack[0], part1);
        uint mask = block + 1;
        for (uint level = 1; level < depth && (mask & 1) == 0; level++) {
            stack[level] = nm_bf16_moment_vector_join(stack[level], stack[level - 1]);
            stack[level - 1] = {0, 0, 0};
            mask >>= 1;
        }
    }
    for (uint i = 1; i < depth; i++)
        stack[0] = nm_bf16_moment_vector_join(stack[0], stack[i]);
    nm_bf16_moment total = {0, 0, 0};
    for (uint j = vectors * 8; j < width; j++) {
        float value = rd(x, base + j, a.t[2]), delta = value - total.mean;
        total.count++;
        total.mean += delta / float(total.count);
        total.m2 += delta * (value - total.mean);
    }
    for (uint j = 0; j < 4; j++) {
        nm_bf16_moment part = {vectors * 2, simd_shuffle(stack[0].mean, j),
                               simd_shuffle(stack[0].m2, j)};
        total = nm_bf16_moment_scalar_join(total, part);
    }
    float factor = 1.0f / precise::sqrt(total.m2 / float(width) + a.f[0]);
    float shift = -factor * total.mean;
    simdgroup_barrier(mem_flags::mem_device);
    for (uint j = lane; j < width; j += 4) {
        float z = rd(x, base + j, a.t[2]) * factor + shift;
        if (a.u[3])
            z = rnd(z, a.t[2]);
        if (a.u[2])
            z *= rd(weight, j, a.t[3]) + (a.u[2] == 2 ? 1.0f : 0.0f);
        if (a.u[4])
            z += rd(bias, j, a.t[4]);
        wr(y, base + j, a.t[1], z);
    }
}

// Ordered BF16 convolution, with no im2col staging. FP32 stays separate.
kernel void nm_bf16_conv(constant ds4_nm_args &a [[buffer(0)]], device uchar *y [[buffer(1)]],
                         device const uchar *x [[buffer(2)]], device const uchar *w [[buffer(3)]],
                         device const uchar *bias [[buffer(4)]],
                         uint gid [[thread_position_in_grid]]) {
#pragma clang fp contract(off)
    ulong i = gid;
    if (i >= a.n[0])
        return;
    uint icg = a.u[0] / a.u[2], ocg = a.u[1] / a.u[2], out[3] = {a.u[21], a.u[22], a.u[23]}, p[3];
    ulong spatial = ulong(out[0]) * out[1] * out[2], ins = ulong(a.u[3]) * a.u[4] * a.u[5],
          ks = ulong(a.u[6]) * a.u[7] * a.u[8], rem = i % spatial;
    uint oc = (i / spatial) % a.u[1], bt = i / (spatial * a.u[1]);
    for (int d = 2; d >= 0; d--) {
        p[d] = rem % out[d];
        rem /= out[d];
    }
    float sums[4] = {};
    ulong inner = ulong(icg) * ks, aligned = inner / 4 * 4;
    for (uint c = 0; c < icg; c++)
        for (ulong j = 0; j < ks; j++) {
            ulong r = j, xi = 0;
            bool ok = true;
            long coord[3];
            for (int d = 2; d >= 0; d--) {
                coord[d] = long(p[d]) * a.u[9 + d] + long(r % a.u[6 + d]) * a.u[12 + d] -
                           long(a.u[15 + d]);
                r /= a.u[6 + d];
                if (coord[d] < 0 || coord[d] >= a.u[3 + d])
                    ok = false;
            }
            if (!ok)
                continue;
            for (uint d = 0; d < 3; d++)
                xi = xi * a.u[3 + d] + coord[d];
            uint channel = oc / ocg * icg + c;
            ulong flat = ulong(c) * ks + j;
            uint slot = flat < aligned ? flat % 4 : 0;
            float left = rd(x, (ulong(bt) * a.u[0] + channel) * ins + xi, a.t[2]);
            float right = rd(w, (ulong(oc) * icg + c) * ks + j, a.t[3]);
            sums[slot] = fma(left, right, sums[slot]);
        }
    wr(y, i, a.t[1],
       (((sums[0] + sums[1]) + sums[2]) + sums[3]) + (a.u[24] ? rd(bias, oc, a.t[4]) : 0.0f));
}
// The image VAE has a single frame and square 1x1/3x3 kernels. Four lanes
// own the four CPU BLAS streams; two spatial outputs reuse each weight.
template <uint K>
kernel void nm_bf16_conv2d(constant ds4_nm_args &a [[buffer(0)]],
                           device uchar *y [[buffer(1)]],
                           device const uchar *x [[buffer(2)]],
                           device const uchar *w [[buffer(3)]],
                           device const uchar *bias [[buffer(4)]],
                           uint gid [[thread_position_in_grid]],
                           uint lane [[thread_index_in_simdgroup]]) {
#pragma clang fp contract(off)
    uint stream = lane % 4, spatial = a.u[22] * a.u[23], pairs = (spatial + 1) / 2;
    uint pair = gid / 4, p0 = pair % pairs * 2, p1 = min(p0 + 1, spatial - 1);
    uint oc = pair / pairs % a.u[1], batch = pair / pairs / a.u[1];
    uint icg = a.u[0] / a.u[2], ocg = a.u[1] / a.u[2];
    ulong ins = ulong(a.u[4]) * a.u[5];
    long y0 = long(p0 / a.u[23]) * a.u[10] - a.u[16],
         y1 = long(p1 / a.u[23]) * a.u[10] - a.u[16],
         x0 = long(p0 % a.u[23]) * a.u[11] - a.u[17],
         x1 = long(p1 % a.u[23]) * a.u[11] - a.u[17];
    float2 sum = 0;
    for (uint block = 0; block < icg; block += 4) {
        // Each lane sees flat=stream, stream+4, ... in the original dot.
        // K is a compile-time constant, avoiding generic 3D divisions.
        for (uint j = 0; j < K * K; j++) {
            uint flat = j * 4 + stream, channel = block + flat / (K * K),
                 at = flat % (K * K);
            long ky = long(at / K) * a.u[13], kx = long(at % K) * a.u[14];
            ulong base = (ulong(batch) * a.u[0] + oc / ocg * icg + channel) * ins;
            float weight = rd(w, (ulong(oc) * icg + block) * K * K + flat, a.t[3]);
            if (y0 + ky >= 0 && y0 + ky < a.u[4] && x0 + kx >= 0 && x0 + kx < a.u[5])
                sum.x = fma(rd(x, base + ulong(y0 + ky) * a.u[5] + x0 + kx, a.t[2]),
                            weight, sum.x);
            if (y1 + ky >= 0 && y1 + ky < a.u[4] && x1 + kx >= 0 && x1 + kx < a.u[5])
                sum.y = fma(rd(x, base + ulong(y1 + ky) * a.u[5] + x1 + kx, a.t[2]),
                            weight, sum.y);
        }
    }
    uint first = lane / 4 * 4;
    float2 total = ((simd_shuffle(sum, first) + simd_shuffle(sum, first + 1)) +
                    simd_shuffle(sum, first + 2)) + simd_shuffle(sum, first + 3);
    if (!stream) {
        float b = a.u[24] ? rd(bias, oc, a.t[4]) : 0.0f;
        ulong base = (ulong(batch) * a.u[1] + oc) * spatial;
        wr(y, base + p0, a.t[1], total.x + b);
        if (p0 + 1 < spatial)
            wr(y, base + p0 + 1, a.t[1], total.y + b);
    }
}

template [[host_name("nm_bf16_conv2d_1")]]
kernel decltype(nm_bf16_conv2d<1>) nm_bf16_conv2d<1>;
template [[host_name("nm_bf16_conv2d_3")]]
kernel decltype(nm_bf16_conv2d<3>) nm_bf16_conv2d<3>;

// Channel-major BF16 input preserves the CPU transposed GEMM order.
kernel void nm_bf16_linear_transposed(constant ds4_nm_args &a [[buffer(0)]],
                                      device uchar *y [[buffer(1)]],
                                      device const uchar *x [[buffer(2)]],
                                      device const uchar *w [[buffer(3)]],
                                      device const uchar *bias [[buffer(4)]],
                                      uint gid [[thread_position_in_grid]]) {
#pragma clang fp contract(off)
    uint rows = a.u[0], inner = a.u[1], cols = a.u[2];
    ulong index = gid;
    if (index >= ulong(rows) * cols)
        return;
    uint row = index / cols, col = index % cols;
    float sums[4] = {};
    uint aligned = inner / 4 * 4;
    for (uint k = 0; k < inner; k++) {
        uint slot = k < aligned ? k % 4 : 0;
        sums[slot] = fma(rd(x, ulong(k) * rows + row, a.t[2]),
                         rd(w, ulong(col) * inner + k, a.t[3]), sums[slot]);
    }
    float sum = ((sums[0] + sums[1]) + sums[2]) + sums[3];
    if (a.u[3])
        sum += rd(bias, col, a.t[4]);
    wr(y, index, a.t[1], sum);
}

// Preserve CPU outer-reduction geometry for channel-major BF16 audio.
kernel void nm_bf16_channel_rms(constant ds4_nm_args &a [[buffer(0)]],
                                device uchar *y [[buffer(1)]], device const uchar *x [[buffer(2)]],
                                device const uchar *weight [[buffer(3)]],
                                uint p [[threadgroup_position_in_grid]],
                                uint lane [[thread_index_in_threadgroup]]) {
#pragma clang fp contract(off)
    if (lane >= 4)
        return;
    uint channels = a.u[0], spatial = a.u[1];
    bool wide = p < spatial / 32 * 32;
    uint streams = wide ? 1 : 4, count = channels / streams;
    uint power = max(4u, (count > 1 ? 32u - clz(count - 1) : 0u) / 4u), step = 1u << power,
         mask = step - 1;
    float levels[4] = {};
    for (uint i = 0; i < count && lane < streams; i++) {
        float value = rd(x, ulong(i * streams + lane) * spatial + p, a.t[2]);
        levels[0] += value * value;
        if ((i + 1) % step == 0)
            for (uint level = 1; level < 4; level++) {
                levels[level] += levels[level - 1];
                levels[level - 1] = 0;
                if ((i + 1) & (mask << (level * power)))
                    break;
            }
    }
    float part = ((levels[0] + levels[1]) + levels[2]) + levels[3];
    if (!lane)
        for (uint c = count * streams; c < channels; c++) {
            float value = rd(x, ulong(c) * spatial + p, a.t[2]);
            part += value * value;
        }
    float sum = wide ? simd_shuffle(part, 0)
                     : ((simd_shuffle(part, 0) + simd_shuffle(part, 1)) + simd_shuffle(part, 2)) +
                           simd_shuffle(part, 3);
    float factor = 1.0f / precise::sqrt(sum / channels + a.f[0]);
    for (uint c = lane; c < channels; c += 4) {
        float value = rd(x, ulong(c) * spatial + p, a.t[2]) * factor;
        wr(y, ulong(p) * channels + c, a.t[1], value * rd(weight, c, a.t[3]));
    }
}

inline float nm_sleef_sin(float value) {
#pragma clang fp contract(off)
    if (!(abs(value) < 125.0f))
        return sin(value);
    if ((as_type<uint>(value) & 0x7fffffff) < 0x00800000)
        return value;
    int q = int(rint(value * 0.31830988618379067154f));
    float d = fma(float(q), -3.1414794921875f, value);
    d = fma(float(q), -0.00011315941810607910156f, d);
    d = fma(float(q), -1.9841872589410058936e-09f, d);
    float s = d * d;
    d = as_type<float>(as_type<uint>(d) ^ ((q & 1) ? 0x80000000u : 0u));
    float u = 2.6083159809786593541503e-06f;
    u = fma(u, s, -0.0001981069071916863322258f);
    u = fma(u, s, 0.00833307858556509017944336f);
    u = fma(u, s, -0.166666597127914428710938f);
    return s * (u * d) + d;
}
inline float nm_sleef_cos(float value) {
#pragma clang fp contract(off)
    if (!(abs(value) < 125.0f))
        return cos(value);
    int q = 2 * int(rint(value * 0.31830988618379067154f - 0.5f)) + 1;
    float d = fma(float(q), -3.1414794921875f * 0.5f, value);
    d = fma(float(q), -0.00011315941810607910156f * 0.5f, d);
    d = fma(float(q), -1.9841872589410058936e-09f * 0.5f, d);
    float s = d * d;
    d = as_type<float>(as_type<uint>(d) ^ ((q & 2) == 0 ? 0x80000000u : 0u));
    float u = 2.6083159809786593541503e-06f;
    u = fma(u, s, -0.0001981069071916863322258f);
    u = fma(u, s, 0.00833307858556509017944336f);
    u = fma(u, s, -0.166666597127914428710938f);
    return s * (u * d) + d;
}

// FP32 expression of pinned ATen NEON erf and its Arm exp_u20 polynomial.
// PyTorch d0f2af8, vec128_float_neon.h. See third_party/pytorch/LICENSE.
inline float nm_neon_exp_u20(float x) {
#pragma clang fp contract(off)
    if (abs(x) > 0x1.5d5e2ap+6f)
        return nm_sleef_exp(x);
    float exponent = round(x * 0x1.715476p+0f);
    float r = fma(-exponent, 0x1.62e4p-1f, x);
    r = fma(-exponent, 0x1.7f7d1cp-20f, r);
    float scale = as_type<float>((uint(int(exponent)) << 23) + 0x3f800000u);
    float square = r * r;
    float p = fma(r, 0x1.0e4020p-7f, 0x1.573e2ep-5f);
    float q = fma(r, 0x1.555e66p-3f, 0x1.fffdb6p-2f);
    q = fma(p, square, q);
    p = 0x1.ffffecp-1f * r;
    float polynomial = fma(q, square, p);
    return fma(polynomial, scale, scale);
}
inline float nm_bf16_gelu_erf(float value) {
#pragma clang fp contract(off)
    float x = value * 0.70710678118654752440f;
    float t = 1.0f / fma(0.3275911f, abs(x), 1.0f);
    float r = fma(1.061405429f, t, -1.453152027f);
    r = fma(r, t, 1.421413741f);
    r = fma(r, t, -0.284496736f);
    r = fma(r, t, 0.254829592f);
    float e = nm_neon_exp_u20(-(x * x));
    float result = fma(t * -e, r, 1.0f);
    result = as_type<float>(as_type<uint>(result) ^ (as_type<uint>(x) & 0x80000000u));
    return value * 0.5f * (1.0f + result);
}
