# Explicit starting profile for Qwen3.8 27B Quick Chat on Apple Silicon.
# Source under `set -a` in each shell before the existing server/UI launchers.
# Preparation only: real inference still requires memory admission and qualification.
# Historical resident 4k preparation; the roadmap tracks streamed 8k separately.
DS4_BACKEND=metal
DS4_MODEL_PROFILE=qwen27
DS4_CTX=4096
DS4_PREFILL_CHUNK=64
DS4_MTP=0
DS4_VISION_MODEL=
DS4_SUITE_CONFIG=

BASE_URL=http://127.0.0.1:8080/v1
API_KEY=local
DEFAULT_MODEL=Qwen3.8-27B-UD-Q4_K_S
CONTEXT_LENGTH=4096
REASONING_EFFORT=none
API_TYPE=responses
