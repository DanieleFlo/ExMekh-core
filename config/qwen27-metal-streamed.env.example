# Source with `set -a` before agent/start-ds4-server.sh and the UI launcher.
# One native session, explicit bounded SSD reads, target-only 8192/64.
DS4_BACKEND=metal
DS4_MODEL_PROFILE=qwen27
DS4_CTX=8192
DS4_PREFILL_CHUNK=64
DS4_SSD_STREAMING=1
# Empty: use measured available RAM after graph/MTP/restore costs.
# Explicit user-selected profile: no fixed host reserve.
DS4_METAL_HOST_RESERVE_BYTES=0
DS4_SSD_CACHE_GB=
DS4_MTP=0
DS4_VISION_MODEL=
DS4_SUITE_CONFIG=

BASE_URL=http://127.0.0.1:8080/v1
API_KEY=local
DEFAULT_MODEL=Qwen3.8-27B-UD-Q4_K_S
CONTEXT_LENGTH=8192
REASONING_EFFORT=none
API_TYPE=responses
