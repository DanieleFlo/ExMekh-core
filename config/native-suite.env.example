# Copy to config/native-suite.env and set the installed native dependency paths.
# Caller-provided values take precedence. No Python runtime is used by the server.
SUITE_MEDIA_PREFIX="${SUITE_MEDIA_PREFIX:-/absolute/path/to/native-media}"
SUITE_CUDA_LIBDIR="${SUITE_CUDA_LIBDIR:-/absolute/path/to/cuda-libraries}"
CUDNN_HOME="${CUDNN_HOME:-/absolute/path/to/cudnn}"
