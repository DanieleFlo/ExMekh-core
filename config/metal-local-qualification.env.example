# Temporary qualification on this slow Apple Silicon machine.
# Source explicitly for a qualification command; ordinary launchers are unchanged.
# Restore baseline deadlines with:
# unset DS4_METAL_TIMEOUT_MULTIPLIER EXMEKH_INTERACTIVE_TIMEOUT_SECONDS
export DS4_METAL_TIMEOUT_MULTIPLIER=4
# Explicit SDK setting; without this variable the default remains 300 seconds.
export EXMEKH_INTERACTIVE_TIMEOUT_SECONDS=1200
